{
  "name": "ymg-events-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    {
      "name": "EVENTS_SUBMISSION_LIMITER",
      "namespace_id": "2026111010",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
